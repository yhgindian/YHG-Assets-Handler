<local:DarkWindow
    x:Class="AssetsHandler.Controls.FindWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AssetsHandler.Controls"
    Title="Find"
    Width="420"
    Height="140"
    Background="#FF1E1E1E"
    Foreground="#FFF1F1F1"
    ResizeMode="NoResize"
    ShowButtons="Close"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top Input & Buttons  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <local:DarkTextBox_01
                x:Name="FindTextBox"
                Grid.Column="0"
                Height="28"
                Padding="6,0"
                VerticalContentAlignment="Center"
                Background="#FF2D2D30"
                BorderBrush="#FF3F3F46"
                Foreground="#FFF1F1F1"
                KeyDown="FindTextBox_KeyDown"
                OnHoverBorder="#FF3B82F6" />

            <local:DarkButton_01
                Grid.Column="1"
                Width="28"
                Height="28"
                Margin="4,0,0,0"
                Background="#FF2D2D30"
                BorderBrush="#FF3F3F46"
                Click="NextMatch_Click"
                Foreground="#FFF1F1F1"
                OnHoverBorder="#FF3B82F6"
                ToolTip="Next Match (Enter)">
                <Path
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 0 3 L 5 8 L 10 3 Z"
                    Fill="#FFF1F1F1" />
            </local:DarkButton_01>

            <local:DarkButton_01
                Grid.Column="2"
                Width="28"
                Height="28"
                Margin="2,0,0,0"
                Background="#FF2D2D30"
                BorderBrush="#FF3F3F46"
                Click="PrevMatch_Click"
                Foreground="#FFF1F1F1"
                OnHoverBorder="#FF3B82F6"
                ToolTip="Previous Match (Shift+Enter)">
                <Path
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 0 8 L 5 3 L 10 8 Z"
                    Fill="#FFF1F1F1" />
            </local:DarkButton_01>

            <local:DarkButton_01
                Grid.Column="3"
                Width="28"
                Height="28"
                Margin="4,0,0,0"
                Background="#FF2D2D30"
                BorderBrush="#FF3F3F46"
                Click="CloseButton_Click"
                Foreground="#FFF1F1F1"
                OnHoverBg="#EF4444"
                ToolTip="Close (Esc)">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="✕" />
            </local:DarkButton_01>
        </Grid>

        <!--  Bottom Options  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,8,0,0"
            Orientation="Horizontal">
            <local:DarkToggleButton_01
                x:Name="BtnMatchCase"
                Width="28"
                Height="22"
                Margin="0,0,4,0"
                OffColor="#FF3F3F46"
                OnColor="#FF3B82F6"
                ToolTip="Match Case">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="Bold"
                    Text="Aa" />
            </local:DarkToggleButton_01>

            <local:DarkToggleButton_01
                x:Name="BtnWholeWord"
                Width="28"
                Height="22"
                Margin="0,0,4,0"
                OffColor="#FF3F3F46"
                OnColor="#FF3B82F6"
                ToolTip="Match Whole Word">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="Bold"
                    Text="W" />
            </local:DarkToggleButton_01>

            <local:DarkToggleButton_01
                x:Name="BtnRegex"
                Width="28"
                Height="22"
                OffColor="#FF3F3F46"
                OnColor="#FF3B82F6"
                ToolTip="Regular Expression">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="Bold"
                    Text=".*" />
            </local:DarkToggleButton_01>

            <TextBlock
                x:Name="TxtMatchStatus"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="#FFA0A0A0"
                Text="0 results" />
        </StackPanel>
    </Grid>
</local:DarkWindow>