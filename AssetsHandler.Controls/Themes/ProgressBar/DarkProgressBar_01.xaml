<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AssetsHandler.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AssetsHandler.Controls;component/Themes/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type local:DarkProgressBar_01}">
        <Setter Property="Height" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        <Setter Property="TrackBrush" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="FillBrush" Value="#FF3B82F6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DarkProgressBar_01}">
                    <Border
                        x:Name="PART_Root"
                        Background="{TemplateBinding TrackBrush}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding ActualFill}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Border
                                    x:Name="PART_Rainbow"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Visibility="Collapsed" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsClickable" Value="True">
                            <Setter TargetName="PART_Root" Property="Cursor" Value="Hand" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>