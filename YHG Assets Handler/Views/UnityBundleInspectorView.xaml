<UserControl
    x:Class="YHG_Assets_Handler.Views.UnityBundleInspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:YHG_Assets_Handler.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    Foreground="{StaticResource TextLight}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ActionBtn" TargetType="DarkButton_01">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="OnHoverBg" Value="#1E293B" />
            <Setter Property="OnHoverBorder" Value="{StaticResource NeonAccent}" />
            <Setter Property="OnHoverForeground" Value="{StaticResource NeonAccent}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="260" MinWidth="220" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Column="0"
            Padding="8"
            Style="{StaticResource PanelBorder_01}">
            <DarkDataGrid_01
                x:Name="BundleGrid"
                ItemsSource="{Binding BundleEntries}"
                SelectedItem="{Binding SelectedBundleItem, Mode=TwoWay}"
                SelectionChanged="DataGrid_SelectionChanged"
                SelectionMode="Extended">
                <DarkDataGrid_01.Columns>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="180"
                        Binding="{Binding Name}"
                        Header="Name" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Size}"
                        Header="Size" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding Modified}"
                        Header="Modified" />
                </DarkDataGrid_01.Columns>
            </DarkDataGrid_01>
        </Border>
        <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Center"
            Background="Transparent" />
        <Border Grid.Column="2" Style="{StaticResource PanelBorder_01}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource SectionTitle_01}" Text="Bundle" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource TextMuted}"
                        Text="{Binding BundleEntries.Count, StringFormat='{}{0} item(s)'}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{StaticResource TextMuted}"
                        Text="{Binding EngineVersion, StringFormat='{}Unity: {0}'}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{StaticResource TextMuted}"
                        Text="{Binding BundleCompression, StringFormat='{}Compression: {0}'}" />
                    <Separator Margin="0,14" Background="{StaticResource BorderColor}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Style="{StaticResource SectionTitle_01}"
                        Text="Selected Item" />
                    <DarkButton_01
                        Command="{Binding ExportCommand}"
                        OnHoverBorder="#10B981"
                        OnHoverForeground="#10B981"
                        Style="{StaticResource ActionBtn}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="13"
                                Height="13"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DarkButton_01}}"
                                Kind="Export" />
                            <TextBlock VerticalAlignment="Center" Text="Export" />
                        </StackPanel>
                    </DarkButton_01>
                    <DarkButton_01
                        Command="{Binding ImportCommand}"
                        OnHoverBorder="#3B82F6"
                        OnHoverForeground="#3B82F6"
                        Style="{StaticResource ActionBtn}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="13"
                                Height="13"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DarkButton_01}}"
                                Kind="Import" />
                            <TextBlock VerticalAlignment="Center" Text="Import (replace)" />
                        </StackPanel>
                    </DarkButton_01>
                    <Separator Margin="0,8" Background="{StaticResource BorderColor}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Style="{StaticResource SectionTitle_01}"
                        Text="Bundle Operations" />
                    <DarkButton_01
                        Command="{Binding AddCommand}"
                        OnHoverBorder="#10B981"
                        OnHoverForeground="#10B981"
                        Style="{StaticResource ActionBtn}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="13"
                                Height="13"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DarkButton_01}}"
                                Kind="PlusBox" />
                            <TextBlock VerticalAlignment="Center" Text="Add..." />
                        </StackPanel>
                    </DarkButton_01>
                    <Separator Margin="0,8" Background="{StaticResource BorderColor}" />
                    <DarkButton_01
                        Command="{Binding DeleteCommand}"
                        OnHoverBg="#2A1215"
                        OnHoverBorder="#EF4444"
                        OnHoverForeground="#EF4444"
                        Style="{StaticResource ActionBtn}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="13"
                                Height="13"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DarkButton_01}}"
                                Kind="TrashCanOutline" />
                            <TextBlock VerticalAlignment="Center" Text="Delete" />
                        </StackPanel>
                    </DarkButton_01>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>