<UserControl
    x:Class="YHG_Assets_Handler.Views.Controls.ToastView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Margin="0,0,0,8"
    Focusable="False">

    <Border
        x:Name="Card"
        Background="#FF1C1C21"
        BorderBrush="#FF2E2E35"
        BorderThickness="1"
        CornerRadius="8">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>

        <Grid>
            <!--  Left accent stripe  -->
            <Border
                x:Name="Stripe"
                Width="4"
                HorizontalAlignment="Left"
                CornerRadius="7,0,0,7" />

            <Grid Margin="16,12,10,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Circle icon  -->
                <Grid
                    Width="34"
                    Height="34"
                    VerticalAlignment="Center">
                    <Ellipse x:Name="IconBg" Opacity="0.18" />
                    <iconPacks:PackIconMaterial
                        x:Name="TypeIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,8,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12.5"
                        Foreground="#FF9AA0A6"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <DarkButton_01
                    Grid.Column="2"
                    Width="22"
                    Height="22"
                    Padding="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DismissCommand}"
                    CornerRadius="4"
                    Focusable="False"
                    Foreground="#FF9AA0A6"
                    OnHoverBg="#33FFFFFF"
                    OnHoverBorder="Transparent"
                    OnHoverForeground="White"
                    ToolTip="Close">
                    <iconPacks:PackIconMaterial
                        Width="9"
                        Height="9"
                        Kind="Close" />
                </DarkButton_01>
            </Grid>

            <!--  Countdown bar  -->
            <Border
                x:Name="TimerBar"
                Height="3"
                Margin="16,0,12,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                CornerRadius="1.5"
                RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="BarScale" ScaleX="1" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Border>
</UserControl>