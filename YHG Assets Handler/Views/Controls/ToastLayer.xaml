<UserControl
    x:Class="YHG_Assets_Handler.Views.Controls.ToastLayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:AssetsHandler.Core.NotificationManager;assembly=AssetsHandler.Core"
    xmlns:local="clr-namespace:YHG_Assets_Handler.Views.Controls"
    Width="380"
    Margin="0,0,12,32"
    HorizontalAlignment="Right"
    VerticalAlignment="Bottom"
    Focusable="False">

    <ItemsControl Focusable="False" ItemsSource="{x:Static core:NotificationManager.Items}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type core:NotificationItem}">
                <local:ToastView />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>