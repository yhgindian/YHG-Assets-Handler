<UserControl
    x:Class="YHG_Assets_Handler.Views.UnityAssetsInspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="550"
    d:DesignWidth="900"
    Background="Transparent"
    Foreground="{StaticResource TextLight}"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding
            Key="G"
            Command="{Binding OpenGoToDialogCommand}"
            Modifiers="Ctrl" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="260" MinWidth="220" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Column="0"
            Padding="8"
            Style="{StaticResource PanelBorder_01}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DarkDataGrid_01
                    x:Name="AssetGrid"
                    Grid.Row="0"
                    ItemsSource="{Binding AssetObjects}"
                    SearchColumns="Name, Type"
                    SelectionChanged="DataGrid_SelectionChanged">
                    <DarkDataGrid_01.Columns>
                        <DataGridTextColumn
                            Width="2*"
                            MinWidth="180"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="1.5*"
                            MinWidth="140"
                            Binding="{Binding Container}"
                            Header="Containers" />
                        <DataGridTextColumn
                            Width="Auto"
                            MinWidth="90"
                            Binding="{Binding Type}"
                            Header="Type" />
                        <DataGridTextColumn
                            Width="Auto"
                            MinWidth="65"
                            Binding="{Binding FileID}"
                            Header="FileID">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="Auto"
                            MinWidth="120"
                            Binding="{Binding PathID}"
                            Header="PathID" />
                        <DataGridTextColumn
                            Width="Auto"
                            MinWidth="75"
                            Binding="{Binding Size}"
                            Header="Size" />
                        <DataGridTextColumn
                            Width="Auto"
                            MinWidth="75"
                            Binding="{Binding Modified}"
                            Header="Modified">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DarkDataGrid_01.Columns>
                </DarkDataGrid_01>
            </Grid>
        </Border>
        <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Center"
            Background="Transparent" />
        <Border
            Grid.Column="2"
            ClipToBounds="True"
            Style="{StaticResource PanelBorder_01}">
            <TabControl SelectionChanged="TabControl_SelectionChanged" Style="{StaticResource DarkTabControl_01}">
                <TabItem Header="Info">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,12,12,12">
                            <TextBlock Style="{StaticResource SectionTitle_01}" Text="Object Properties" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource PropLabel_01}"
                                    Text="Name:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource PropValue_01}"
                                    Text="{Binding ActiveAssetObject.Name}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource PropLabel_01}"
                                    Text="Path ID:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Foreground="{StaticResource NeonAccent}"
                                    Style="{StaticResource PropValue_01}"
                                    Text="{Binding ActiveAssetObject.PathID}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource PropLabel_01}"
                                    Text="Data Size:" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Foreground="{StaticResource AccentWarm}"
                                    Style="{StaticResource PropValue_01}"
                                    Text="{Binding ActiveAssetObject.Size}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource PropLabel_01}"
                                    Text="Type Name:" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Foreground="{StaticResource AccentGreen}"
                                    Style="{StaticResource PropValue_01}"
                                    Text="{Binding ActiveAssetObject.Type}" />
                            </Grid>
                            <Separator Margin="0,16" Background="{StaticResource BorderColor}" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource SectionTitle_01}"
                                Text="Asset Operations" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DarkButton_01
                                    Grid.Column="0"
                                    Command="{Binding ExportRawCommand}"
                                    Content="Export Raw"
                                    OnHoverBg="#1E293B"
                                    OnHoverBorder="#10B981"
                                    OnHoverForeground="#10B981" />
                                <DarkButton_01
                                    Grid.Column="2"
                                    Command="{Binding ImportRawCommand}"
                                    Content="Import Raw"
                                    OnHoverBg="#1E293B"
                                    OnHoverBorder="#3B82F6"
                                    OnHoverForeground="#3B82F6" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DarkButton_01
                                    Grid.Column="0"
                                    Command="{Binding ExportDumpCommand}"
                                    Content="Export Dump"
                                    OnHoverBg="#1E293B"
                                    OnHoverBorder="#10B981"
                                    OnHoverForeground="#10B981" />
                                <DarkButton_01
                                    Grid.Column="2"
                                    Command="{Binding ImportDumpCommand}"
                                    Content="Import Dump"
                                    OnHoverBg="#1E293B"
                                    OnHoverBorder="#3B82F6"
                                    OnHoverForeground="#3B82F6" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DarkButton_01
                                    Grid.Column="0"
                                    Command="{Binding ViewDataCommand}"
                                    Content="View Data"
                                    OnHoverBg="#1E293B"
                                    OnHoverBorder="#F59E0B"
                                    OnHoverForeground="#F59E0B" />
                                <DarkButton_01
                                    Grid.Column="2"
                                    Command="{Binding EditDataCommand}"
                                    Content="Edit Data"
                                    OnHoverBg="#1E293B"
                                    OnHoverBorder="#6366F1"
                                    OnHoverForeground="#6366F1" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DarkButton_01
                                    x:Name="BtnPlugins"
                                    Grid.Column="0"
                                    Command="{Binding PluginsCommand}"
                                    CommandParameter="{Binding ElementName=BtnPlugins}"
                                    Content="Plugins"
                                    OnHoverBg="#1E293B"
                                    OnHoverBorder="#A855F7"
                                    OnHoverForeground="#A855F7" />
                                <DarkButton_01
                                    x:Name="BtnUtils"
                                    Grid.Column="2"
                                    Command="{Binding UtilsCommand}"
                                    CommandParameter="{Binding ElementName=BtnUtils}"
                                    Content="Utils"
                                    OnHoverBg="#1E293B"
                                    OnHoverBorder="#14B8A6"
                                    OnHoverForeground="#14B8A6">
                                    <DarkButton_01.ContextMenu>
                                        <ContextMenu x:Name="UtilsContextMenu">
                                            <DarkMenuItem_01 Header="Copy Gos" ToolTip="Copy Selected GameObjects" />
                                        </ContextMenu>
                                    </DarkButton_01.ContextMenu>
                                </DarkButton_01>
                            </Grid>
                            <DarkButton_01
                                Margin="0,0,0,10"
                                Command="{Binding PreviewCommand}"
                                Content="Preview"
                                OnHoverBg="#1E293B"
                                OnHoverBorder="#F59E0B"
                                OnHoverForeground="#F59E0B" />
                            <Separator Margin="0,4,0,10" Background="{StaticResource BorderColor}" />
                            <DarkButton_01
                                Command="{Binding RemoveAssetCommand}"
                                Content="Remove Object"
                                OnHoverBg="#2A1215"
                                OnHoverBorder="#EF4444"
                                OnHoverForeground="#EF4444" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Preview">
                    <Grid Background="#121212">
                        <TextBlock
                            Margin="20"
                            VerticalAlignment="Center"
                            Style="{StaticResource EmptyStateText_01}"
                            Text="Comming Soon"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>