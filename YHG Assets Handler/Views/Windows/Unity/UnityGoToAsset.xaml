<DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.Unity.UnityGoToAsset"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Go To Asset"
    Width="380"
    Height="210"
    Background="#FF1E1E1E"
    Foreground="#FFF1F1F1"
    ResizeMode="NoResize"
    ShowButtons="Close"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  FileID Row  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="#FFA0A0A0"
            Text="File ID:" />

        <DarkTextBox_01
            x:Name="TxtFileId"
            Grid.Row="0"
            Grid.Column="1"
            Height="28"
            Padding="6,0"
            VerticalContentAlignment="Center"
            Background="#FF2D2D30"
            BorderBrush="#FF3F3F46"
            Foreground="#FFF1F1F1"
            KeyDown="Input_KeyDown"
            OnHoverBorder="#FF3B82F6"
            Text="0" />

        <!--  PathID Row  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,10,0,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="#FFA0A0A0"
            Text="Path ID:" />

        <DarkTextBox_01
            x:Name="TxtPathId"
            Grid.Row="1"
            Grid.Column="1"
            Height="28"
            Margin="0,10,0,0"
            Padding="6,0"
            VerticalContentAlignment="Center"
            Background="#FF2D2D30"
            BorderBrush="#FF3F3F46"
            Foreground="#FFF1F1F1"
            KeyDown="Input_KeyDown"
            OnHoverBorder="#FF3B82F6" />

        <!--  Error/Status Info  -->
        <TextBlock
            x:Name="TxtStatus"
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,6,0,0"
            VerticalAlignment="Top"
            FontSize="11"
            Foreground="#EF4444"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Buttons Row  -->
        <StackPanel
            Grid.Row="3"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <DarkButton_01
                Width="85"
                Height="28"
                Margin="0,0,8,0"
                Padding="0"
                Click="Cancel_Click"
                Content="Cancel"
                Foreground="#FFF1F1F1"
                OnHoverBg="#3F3F46"
                OnHoverBorder="#52525B" />

            <DarkButton_01
                Width="85"
                Height="28"
                Padding="0"
                Click="Go_Click"
                Content="Go"
                Foreground="#FFF1F1F1"
                OnHoverBg="#1E293B"
                OnHoverBorder="#3B82F6"
                OnHoverForeground="#3B82F6" />
        </StackPanel>
    </Grid>
</DarkWindow>