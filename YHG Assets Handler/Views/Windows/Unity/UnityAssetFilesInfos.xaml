<ctrl:DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.Unity.UnityAssetFilesInfos"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:AssetsHandler.Controls;assembly=AssetsHandler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Unity Asset File Infos"
    Width="720"
    Height="500"
    MinWidth="600"
    MinHeight="400"
    Background="{StaticResource AppBg}"
    Foreground="{StaticResource TextLight}"
    ShowButtons="Close"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Main Tabs  -->
        <TabControl Grid.Row="0" Style="{StaticResource DarkTabControl_01}">

            <!--  1. General Info  -->
            <TabItem Header="General Info">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  Header Info Box  -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="12"
                            Style="{StaticResource PanelBorder_01}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    Style="{StaticResource SectionTitle_01}"
                                    Text="Header Info" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropLabel_01}"
                                        Text="Metadata Size:" />
                                    <ctrl:DarkTextBox_01
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Height="26"
                                        VerticalContentAlignment="Center"
                                        IsReadOnly="True"
                                        Text="{Binding GeneralInfo.MetadataSize}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropLabel_01}"
                                        Text="File Size:" />
                                    <ctrl:DarkTextBox_01
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Height="26"
                                        VerticalContentAlignment="Center"
                                        IsReadOnly="True"
                                        Text="{Binding GeneralInfo.FileSize}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropLabel_01}"
                                        Text="Format:" />
                                    <ctrl:DarkTextBox_01
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Height="26"
                                        VerticalContentAlignment="Center"
                                        IsReadOnly="True"
                                        Text="{Binding GeneralInfo.Format}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropLabel_01}"
                                        Text="First File Offset:" />
                                    <ctrl:DarkTextBox_01
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Height="26"
                                        VerticalContentAlignment="Center"
                                        IsReadOnly="True"
                                        Text="{Binding GeneralInfo.FirstFileOffset}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropLabel_01}"
                                        Text="Endianness:" />
                                    <ctrl:DarkTextBox_01
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Height="26"
                                        VerticalContentAlignment="Center"
                                        IsReadOnly="True"
                                        Text="{Binding GeneralInfo.Endianness}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Metadata Info Box  -->
                        <Border Padding="12" Style="{StaticResource PanelBorder_01}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    Style="{StaticResource SectionTitle_01}"
                                    Text="Metadata Info" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropLabel_01}"
                                        Text="Engine Version:" />
                                    <ctrl:DarkTextBox_01
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Height="26"
                                        VerticalContentAlignment="Center"
                                        IsReadOnly="True"
                                        Text="{Binding GeneralInfo.EngineVersion}" />


                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropLabel_01}"
                                        Text="Platform:" />

                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Read-only platform  -->
                                        <ctrl:DarkTextBox_01
                                            x:Name="TxtPlatform"
                                            Grid.Column="0"
                                            Height="26"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True"
                                            Text="{Binding GeneralInfo.Platform}" />

                                        <ctrl:DarkComboBox_01
                                            x:Name="CmbPlatform"
                                            Grid.Column="0"
                                            Height="26"
                                            DisplayMemberPath="Name"
                                            IsSearchEnabled="True"
                                            Placeholder="Select Platform..."
                                            SearchMemberPath="Name"
                                            Visibility="Collapsed" />

                                        <!--  Action buttons  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Orientation="Horizontal">

                                            <!--  Edit  -->
                                            <ctrl:DarkButton_01
                                                x:Name="BtnEditPlatform"
                                                Width="30"
                                                Height="26"
                                                Padding="0"
                                                Click="BtnEditPlateform_Click"
                                                ToolTip="Edit Platform">

                                                <iconPacks:PackIconMaterial
                                                    Width="14"
                                                    Height="14"
                                                    Kind="Pencil" />
                                            </ctrl:DarkButton_01>

                                            <!--  Cancel  -->
                                            <ctrl:DarkButton_01
                                                x:Name="BtnCancelPlatform"
                                                Width="30"
                                                Height="26"
                                                Margin="0,0,4,0"
                                                Padding="0"
                                                Click="BtnCancelPlatform_Click"
                                                ToolTip="Cancel"
                                                Visibility="Collapsed">

                                                <iconPacks:PackIconMaterial
                                                    Width="14"
                                                    Height="14"
                                                    Kind="Close" />
                                            </ctrl:DarkButton_01>

                                            <!--  Apply  -->
                                            <ctrl:DarkButton_01
                                                x:Name="BtnApplyPlatform"
                                                Width="30"
                                                Height="26"
                                                Padding="0"
                                                Click="BtnApplyPlatform_Click"
                                                ToolTip="Apply Platform"
                                                Visibility="Collapsed">

                                                <iconPacks:PackIconMaterial
                                                    Width="14"
                                                    Height="14"
                                                    Kind="Check" />
                                            </ctrl:DarkButton_01>

                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PropLabel_01}"
                                        Text="Type Tree Enabled:" />
                                    <ctrl:DarkTextBox_01
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Height="26"
                                        VerticalContentAlignment="Center"
                                        IsReadOnly="True"
                                        Text="{Binding GeneralInfo.TypeTreeEnabled}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  2. Externals  -->
            <TabItem Header="Externals">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelBorder_01}">
                        <ctrl:DarkListBox_01
                            BorderThickness="0"
                            ItemsSource="{Binding ExternalsDisplay}"
                            SelectedIndex="{Binding SelectedExternalIndex}" />
                    </Border>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
                        <ctrl:DarkButton_01
                            x:Name="BtnAddExternal"
                            Width="70"
                            Height="26"
                            Margin="0,0,6,0"
                            Padding="0"
                            Click="BtnAddExternal_Click"
                            Content="Add" />
                        <ctrl:DarkButton_01
                            x:Name="BtnEditExternal"
                            Width="70"
                            Height="26"
                            Margin="0,0,6,0"
                            Padding="0"
                            Click="BtnEditExternal_Click"
                            Content="Edit"
                            IsEnabled="{Binding IsExternalSelected}" />
                        <ctrl:DarkButton_01
                            Width="75"
                            Height="26"
                            Margin="0,0,6,0"
                            Padding="0"
                            Command="{Binding RemoveExternalCommand}"
                            Content="Remove"
                            OnHoverBorder="#EF4444"
                            OnHoverForeground="#EF4444" />
                        <Separator
                            Width="1"
                            Height="18"
                            Margin="4,0,8,0"
                            Background="{StaticResource BorderColor}" />
                        <ctrl:DarkButton_01
                            Width="85"
                            Height="26"
                            Margin="0,0,6,0"
                            Padding="0"
                            Command="{Binding MoveUpExternalCommand}"
                            Content="Move Up" />
                        <ctrl:DarkButton_01
                            Width="85"
                            Height="26"
                            Padding="0"
                            Command="{Binding MoveDownExternalCommand}"
                            Content="Move Down" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  3. Script Infos  -->
            <TabItem Header="Script Infos">
                <Grid Margin="0,10,0,0">
                    <Border Style="{StaticResource PanelBorder_01}">
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextLight}"
                            ItemsSource="{Binding ScriptsDisplay}" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!--  Bottom Bar: File Selector  -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="0,10,0,0"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="0,1,0,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextMuted}"
                    Text="Selected Asset File:" />
                <ctrl:DarkComboBox_01
                    Width="300"
                    Height="28"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Files}"
                    SelectedItem="{Binding SelectedFile}" />
            </StackPanel>
        </Border>
    </Grid>
</ctrl:DarkWindow>