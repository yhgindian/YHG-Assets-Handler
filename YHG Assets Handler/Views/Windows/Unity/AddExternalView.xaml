<ctrl:DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.Unity.AddExternalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:AssetsHandler.Controls;assembly=AssetsHandler.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Edit External"
    Width="440"
    Height="245"
    Background="{StaticResource AppBg}"
    Foreground="{StaticResource TextLight}"
    ResizeMode="NoResize"
    ShowButtons="Close"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!--  File Name  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextLight}"
                Text="File name:" />
            <ctrl:DarkTextBox_01
                x:Name="TxtFileName"
                Grid.Row="0"
                Grid.Column="1"
                Height="26"
                VerticalContentAlignment="Center"
                TextChanged="TxtFileName_TextChanged" />

            <!--  Original File Name  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextLight}"
                Text="Original file name:" />
            <ctrl:DarkTextBox_01
                x:Name="TxtOriginalFileName"
                Grid.Row="1"
                Grid.Column="1"
                Height="26"
                VerticalContentAlignment="Center"
                IsEnabled="False" />

            <!--  Dependency Type  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextLight}"
                Text="Dependency type:" />
            <ctrl:DarkComboBox_01
                x:Name="CmbExternalType"
                Grid.Row="2"
                Grid.Column="1"
                Height="26"
                VerticalContentAlignment="Center"
                SelectionChanged="CmbExternalType_SelectionChanged">
                <ComboBoxItem Content="Normal" />
                <ComboBoxItem Content="Cached" />
                <ComboBoxItem Content="Serialized" />
                <ComboBoxItem Content="Meta" />
            </ctrl:DarkComboBox_01>

            <!--  GUID  -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextLight}"
                Text="GUID:" />
            <ctrl:DarkTextBox_01
                x:Name="TxtGuid"
                Grid.Row="3"
                Grid.Column="1"
                Height="26"
                VerticalContentAlignment="Center"
                IsEnabled="False"
                Text="00000000000000000000000000000000" />
        </Grid>

        <!--  Actions  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,14,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ctrl:DarkButton_01
                Width="80"
                Height="26"
                Margin="0,0,8,0"
                Padding="0"
                Click="BtnOk_Click"
                Content="OK"
                IsDefault="True" />
            <ctrl:DarkButton_01
                Width="80"
                Height="26"
                Padding="0"
                Click="BtnCancel_Click"
                Content="Cancel"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</ctrl:DarkWindow>