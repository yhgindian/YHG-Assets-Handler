<DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.FilterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="Filter"
    Width="660"
    Height="420"
    MinWidth="560"
    MinHeight="300"
    Background="{StaticResource AppBg}"
    Foreground="{StaticResource TextLight}"
    ShowButtons="Close"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <DarkWindow.Resources>
        <Style x:Key="HostShow" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HostBool" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </DarkWindow.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top: AND / OR  -->
        <Grid Margin="0,0,0,8">
            <DarkCheckBox_01
                HorizontalAlignment="Left"
                Content="Match all rules (AND)   -   off = any rule (OR)"
                IsChecked="{Binding MatchAllRules}" />
        </Grid>

        <!--  Rules  -->
        <Border
            Grid.Row="1"
            Padding="8"
            Style="{StaticResource PanelBorder_01}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="RulesList"
                    Focusable="False"
                    ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>

                                <DarkCheckBox_01
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsEnabled}"
                                    ToolTip="Rule on / off" />

                                <DarkComboBox_01
                                    Grid.Column="1"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    DisplayMemberPath="DisplayName"
                                    IsSearchEnabled="False"
                                    ItemsSource="{Binding DataContext.Fields, ElementName=RulesList}"
                                    Placeholder="Field"
                                    SelectedItem="{Binding SelectedField}" />

                                <DarkComboBox_01
                                    Grid.Column="2"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    IsSearchEnabled="False"
                                    ItemsSource="{Binding AvailableOperators}"
                                    SelectedItem="{Binding SelectedOperator}" />

                                <!--  Value: text ya (boolean ho to) true/false  -->
                                <Grid Grid.Column="3" Style="{StaticResource HostShow}">
                                    <DarkTextBox_01
                                        Height="28"
                                        Placeholder="Value"
                                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Grid.Column="3" Style="{StaticResource HostBool}">
                                    <DarkComboBox_01
                                        Height="28"
                                        IsSearchEnabled="False"
                                        ItemsSource="{Binding BoolValues}"
                                        SelectedItem="{Binding Value}" />
                                </Grid>

                                <DarkButton_01
                                    Grid.Column="4"
                                    Width="28"
                                    Height="28"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    Command="{Binding DataContext.RemoveRuleCommand, ElementName=RulesList}"
                                    CommandParameter="{Binding}"
                                    Focusable="False"
                                    OnHoverBg="#2A1215"
                                    OnHoverBorder="#EF4444"
                                    OnHoverForeground="#EF4444"
                                    ToolTip="Remove rule">
                                    <iconPacks:PackIconMaterial
                                        Width="12"
                                        Height="12"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DarkButton_01}}"
                                        Kind="TrashCanOutline" />
                                </DarkButton_01>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!--  Bottom bar  -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <DarkButton_01
                    Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    Padding="0"
                    Command="{Binding AddRuleCommand}"
                    OnHoverBorder="#10B981"
                    OnHoverForeground="#10B981">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="12"
                            Height="12"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DarkButton_01}}"
                            Kind="Plus" />
                        <TextBlock VerticalAlignment="Center" Text="Add Rule" />
                    </StackPanel>
                </DarkButton_01>
                <DarkButton_01
                    Width="80"
                    Height="30"
                    Padding="0"
                    Command="{Binding ResetCommand}"
                    Content="Reset"
                    OnHoverBorder="#F59E0B"
                    OnHoverForeground="#F59E0B"
                    ToolTip="Saare rules hatao aur filter band karo" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <DarkButton_01
                    Width="80"
                    Height="30"
                    Margin="0,0,8,0"
                    Padding="0"
                    Command="{Binding ApplyCommand}"
                    Content="Apply"
                    OnHoverBorder="#3B82F6"
                    OnHoverForeground="#3B82F6" />
                <DarkButton_01
                    Width="80"
                    Height="30"
                    Margin="0,0,8,0"
                    Padding="0"
                    Command="{Binding OkCommand}"
                    Content="OK"
                    OnHoverBg="#064E3B"
                    OnHoverBorder="#10B981"
                    OnHoverForeground="#10B981" />
                <DarkButton_01
                    Width="80"
                    Height="30"
                    Padding="0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    OnHoverBg="#2A1215"
                    OnHoverBorder="#EF4444"
                    OnHoverForeground="#EF4444" />
            </StackPanel>
        </Grid>
    </Grid>
</DarkWindow>