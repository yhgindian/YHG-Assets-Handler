<DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.Tools.UnityAssetsMergeSplitter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UnityAssetsMergeSplitter"
    Width="800"
    Height="480"
    Background="{StaticResource AppBg}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10,8,10,4">
            <TabControl Style="{StaticResource DarkTabControl_01}">
                <TabItem Header="File Splitter">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DarkTextBox_01
                                x:Name="TextBoxSplit"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                IsReadOnly="True" />
                            <DarkButton_01
                                x:Name="BrowseSplit"
                                Grid.Column="1"
                                Width="90"
                                Content="Browse"
                                OnHoverBg="#333333"
                                OnHoverBorder="#555555"
                                OnHoverForeground="#FFFFFF" />
                        </Grid>
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <RadioButton
                                x:Name="RadioBySize"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                Content="Split By Size"
                                Foreground="{StaticResource TextLight}"
                                IsChecked="True" />
                            <RadioButton
                                x:Name="RadioByNumber"
                                VerticalAlignment="Center"
                                Content="Split by File Number"
                                Foreground="{StaticResource TextLight}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="2"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <DarkTextBox_01
                                x:Name="NumericSplitSize"
                                Width="120"
                                Height="30"
                                VerticalContentAlignment="Center"
                                Text="100" />
                            <TextBlock
                                x:Name="LabelNumeric"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextLight}"
                                Text="Size (MB)" />
                        </StackPanel>
                        <Grid Grid.Row="3" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="LabelOutput"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextLight}"
                                Text="FileName:" />
                            <DarkTextBox_01
                                x:Name="TextBoxOutput"
                                Grid.Column="1"
                                Height="28"
                                VerticalContentAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextLight}"
                                Opacity="0.7"
                                Text=".split*" />
                        </Grid>
                        <DarkButton_01
                            x:Name="StartSplit"
                            Grid.Row="4"
                            Width="150"
                            HorizontalAlignment="Center"
                            Content="Start Splitting"
                            FontWeight="SemiBold"
                            OnHoverBg="#007ACC"
                            OnHoverBorder="#1F8AD2"
                            OnHoverForeground="#FFFFFF" />
                    </Grid>
                </TabItem>
                <TabItem Header="File Merger">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DarkTextBox_01
                                x:Name="TextBoxMerge"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                IsReadOnly="True" />
                            <DarkButton_01
                                x:Name="BrowseMerge"
                                Grid.Column="1"
                                Width="90"
                                Content="Browse"
                                OnHoverBg="#333333"
                                OnHoverBorder="#555555"
                                OnHoverForeground="#FFFFFF" />
                        </Grid>
                        <TreeView
                            x:Name="TreeViewMerge"
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Background="{StaticResource PanelBg}"
                            BorderBrush="#333333">
                            <TreeView.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextLight}" />
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextLight}" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#264F78" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2A2D2E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                        <DarkButton_01
                            x:Name="StartMerge"
                            Grid.Row="2"
                            Width="150"
                            HorizontalAlignment="Center"
                            Content="Start Merge"
                            FontWeight="SemiBold"
                            OnHoverBg="#007ACC"
                            OnHoverBorder="#1F8AD2"
                            OnHoverForeground="#FFFFFF" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <StatusBar
            Grid.Row="1"
            Height="26"
            Background="#181818"
            BorderBrush="#2d2d2d"
            BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock
                    x:Name="ToolStripStatusLabel"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextLight}"
                    Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</DarkWindow>