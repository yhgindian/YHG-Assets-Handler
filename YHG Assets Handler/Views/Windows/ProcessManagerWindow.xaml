<DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.ProcessManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:AssetsHandler.Core.ProcessManager;assembly=AssetsHandler.Core"
    Title="Background Tasks"
    Width="340"
    MinHeight="90"
    MaxHeight="420"
    IconMode="None"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowButtons="Close"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="Manual">

    <DarkWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  Dynamic brush mapping based on the current process state  -->
        <Style x:Key="TaskBar" TargetType="{x:Type DarkProgressBar_01}">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="IsClickable" Value="False" />
            <Setter Property="ShowPercentToolTip" Value="False" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="FillBrush" Value="#FF3B82F6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Completed">
                    <Setter Property="FillBrush" Value="#FF22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter Property="FillBrush" Value="#FFF59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="FillBrush" Value="#FFEF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type core:ProcessItem}">
            <Border
                Padding="6,6,6,8"
                BorderBrush="#FF3F3F46"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.ColumnSpan="3"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Title}" />

                    <Border
                        x:Name="BarHost"
                        Grid.Row="1"
                        Margin="0,7,0,0"
                        VerticalAlignment="Center">
                        <DarkProgressBar_01 Style="{StaticResource TaskBar}" Value="{Binding BarValue, Mode=OneWay}" />
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="34"
                        Margin="8,6,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#FFC5C5C5"
                        Text="{Binding PercentText}"
                        TextAlignment="Right" />

                    <DarkButton_01
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="18"
                        Height="18"
                        Margin="6,6,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CancelCommand}"
                        CornerRadius="3"
                        Focusable="False"
                        Foreground="#FFC5C5C5"
                        OnHoverBg="#33FFFFFF"
                        OnHoverBorder="Transparent"
                        OnHoverForeground="White"
                        ToolTip="Cancel"
                        Visibility="{Binding CanCancelNow, Converter={StaticResource BoolToVis}}">
                        <Path
                            Width="8"
                            Height="8"
                            Data="M0,0 L8,8 M8,0 L0,8"
                            Stroke="#FFC5C5C5"
                            StrokeThickness="1.3" />
                    </DarkButton_01>

                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="#FF9AA0A6"
                        Text="{Binding Status}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Status}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!--  Indeterminate state: pulses when progress percentage is unknown  -->
                <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="True"
                                    RepeatBehavior="Forever"
                                    Storyboard.TargetName="BarHost"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.25"
                                    To="1"
                                    Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </DarkWindow.Resources>

    <Grid>
        <TextBlock
            x:Name="EmptyText"
            Margin="0,22"
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="#FF9AA0A6"
            Text="No background tasks" />

        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
            <ItemsControl Focusable="False" ItemsSource="{x:Static core:ProcessManager.Processes}" />
        </ScrollViewer>
    </Grid>
</DarkWindow>