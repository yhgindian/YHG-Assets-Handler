<DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About YHG Assets Handler"
    Width="900"
    Height="620"
    MinWidth="700"
    MinHeight="480"
    Background="#0E0E11"
    ShowButtons="Close"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!--  LEFT CONTENT  -->
            <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="20"
                Background="#17171B"
                BorderBrush="#2A2A31"
                BorderThickness="1"
                CornerRadius="10">

                <ScrollViewer
                    CanContentScroll="True"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!--  APP HEADER  -->
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="25"
                                    FontWeight="SemiBold"
                                    Foreground="#E6E6EA"
                                    Text="YHG Assets Handler" />

                                <TextBlock
                                    Margin="1,7,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#00D2FF"
                                    Text="VERSION 1.0.0" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Width="64"
                                Height="64"
                                VerticalAlignment="Center"
                                Background="#1D1D22"
                                BorderBrush="#2A2A31"
                                BorderThickness="1"
                                CornerRadius="12">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#00D2FF"
                                    Text="YHG" />
                            </Border>
                        </Grid>

                        <!--  ABOUT  -->
                        <TextBlock
                            Margin="0,0,0,9"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#00D2FF"
                            Text="ABOUT" />

                        <TextBlock
                            FontSize="13"
                            Foreground="#C8C8CE"
                            LineHeight="21"
                            Text="YHG Assets Handler is a developer-oriented utility designed to handle Unity AssetBundle files and serialized .assets files. It provides advanced asset inspection and processing capabilities to simplify various modding workflows."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,9,0,0"
                            FontSize="13"
                            Foreground="#8A8A93"
                            LineHeight="21"
                            Text="The project is actively evolving, with additional formats and features planned for future releases."
                            TextWrapping="Wrap" />

                        <Border
                            Height="1"
                            Margin="0,22,0,20"
                            Background="#2A2A31" />

                        <!--  FEATURES  -->
                        <TextBlock
                            Margin="0,0,0,13"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#00D2FF"
                            Text="KEY FEATURES" />

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                Foreground="#E6E6EA"
                                Text="•  AssetBundle Handling" />

                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                Foreground="#E6E6EA"
                                Text="•  Serialized Assets File Handling" />

                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                Foreground="#E6E6EA"
                                Text="•  Advanced Asset Inspection" />

                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                Foreground="#E6E6EA"
                                Text="•  Mesh &amp; Texture Processing" />

                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                Foreground="#E6E6EA"
                                Text="•  Developer-Oriented Utilities" />

                            <TextBlock
                                FontSize="13"
                                Foreground="#E6E6EA"
                                Text="•  Additional Modding Features" />
                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,22,0,20"
                            Background="#2A2A31" />

                        <!--  DEVELOPER  -->
                        <TextBlock
                            Margin="0,0,0,13"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#00D2FF"
                            Text="DEVELOPER &amp; CONTACT" />

                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#E6E6EA"
                            Text="Naveen Ojha" />

                        <TextBlock
                            Margin="0,4,0,12"
                            FontSize="12"
                            Foreground="#8A8A93"
                            Text="Team Owner · YHGIndian" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Foreground="#8A8A93"
                            Text="Contact" />

                        <TextBlock FontSize="13">
                            <Hyperlink
                                Foreground="#00D2FF"
                                NavigateUri="mailto:yhgindian@gmail.com"
                                RequestNavigate="OpenLink_RequestNavigate">
                                yhgindian@gmail.com
                            </Hyperlink>
                        </TextBlock>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  RIGHT CONTENT  -->
            <Border
