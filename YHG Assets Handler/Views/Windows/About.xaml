                                        GitHub Repository
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <Border
                                Height="1"
                                Margin="0,0,0,15"
                                Background="#2A2A31" />

                            <!--  FMOD  -->
                            <StackPanel Margin="0,0,0,17">
                                <TextBlock
