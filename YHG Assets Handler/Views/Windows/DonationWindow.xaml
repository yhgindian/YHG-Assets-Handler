<DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.DonationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:YHG_Assets_Handler.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Support YHG Assets Handler"
    Width="380"
    Background="{StaticResource AppBg}"
    Foreground="{StaticResource TextLight}"
    IconMode="None"
    ResizeMode="NoResize"
    ShowButtons="Close"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <StackPanel Margin="20,16,20,18">

        <!--  Header  -->
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <iconPacks:PackIconMaterial
                Width="20"
                Height="20"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="#FFEC4899"
                Kind="Heart" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Support This Project" />
        </StackPanel>

        <TextBlock
            Margin="0,8,0,18"
            HorizontalAlignment="Center"
            Foreground="{StaticResource TextMuted}"
            Text="If this tool saved you time, a small donation keeps it going."
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!--  QR Code  -->
        <Border
            Width="190"
            Height="190"
            Margin="0,0,0,16"
            Padding="8"
            HorizontalAlignment="Center"
            Background="White"
            CornerRadius="10">
            <Image
                x:Name="QrImage"
                Source="/Assets/qr_code.jpeg"
                Stretch="Uniform" />
        </Border>

        <TextBlock
            Margin="0,0,0,14"
            HorizontalAlignment="Center"
            FontSize="11"
            Foreground="{StaticResource TextMuted}"
            Text="Scan to pay via UPI" />

        <!--  UPI ID row  -->
        <Border
            Padding="10,8"
            Background="{StaticResource SurfaceAlt}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconMaterial
                    Width="14"
                    Height="14"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource TextMuted}"
                    Kind="BankTransfer" />

                <TextBlock
                    x:Name="UpiIdText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12.5"
                    Text="yellowhostgamingbs1@oksbi" />

                <DarkButton_01
                    Grid.Column="2"
                    Width="26"
                    Height="26"
                    Padding="0"
                    Click="CopyUpi_Click"
                    OnHoverBg="#1E293B"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    ToolTip="Copy UPI ID">
                    <iconPacks:PackIconMaterial
                        Width="12"
                        Height="12"
                        Kind="ContentCopy" />
                </DarkButton_01>
            </Grid>
        </Border>

        <!--  Buy Me a Coffee  -->
        <DarkButton_01
            Height="36"
            Margin="0,14,0,0"
            Click="BuyMeACoffee_Click"
            OnHoverBg="#3D2A05"
            OnHoverBorder="#FFBF00"
            OnHoverForeground="#FFD54F">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial
                    Width="15"
                    Height="15"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DarkButton_01}}"
                    Kind="CoffeeOutline" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Buy Me a Coffee" />
            </StackPanel>
        </DarkButton_01>

        <!--  Close  -->
        <DarkButton_01
            Height="30"
            Margin="0,8,0,0"
            Padding="0"
            Click="Close_Click"
            Content="Maybe Later"
            OnHoverBg="#2D2D30"
            OnHoverBorder="{StaticResource BorderColor}" />
    </StackPanel>
</DarkWindow>