<DarkWindow
    x:Class="YHG_Assets_Handler.Views.Windows.OptionSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Options"
    Width="460"
    MinWidth="380"
    MaxHeight="620"
    Background="{StaticResource AppBg}"
    Foreground="{StaticResource TextLight}"
    IconMode="None"
    ResizeMode="NoResize"
    ShowButtons="Close"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="10,6,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="HeaderText"
            Margin="0,0,0,10"
            Foreground="{StaticResource TextMuted}"
            TextWrapping="Wrap" />

        <ScrollViewer
            Grid.Row="1"
            MaxHeight="460"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OptionsList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DataTemplate.Resources>
                            <!--  Renders format-specific input controls based on the selected target kind  -->
                            <Style x:Key="ShowChoice" TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="ShowBool" TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBool}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="ShowInput" TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInput}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataTemplate.Resources>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontWeight="SemiBold"
                                Text="{Binding Label}" />

                            <Grid Style="{StaticResource ShowChoice}">
                                <DarkComboBox_01
                                    Height="28"
                                    DisplayMemberPath="{Binding DisplayMemberPath}"
                                    ItemsSource="{Binding Choices}"
                                    OnHoverBorder="{StaticResource NeonAccent}"
                                    Placeholder="{Binding Placeholder}"
                                    SelectedItem="{Binding Value}" />
                            </Grid>

                            <Grid Style="{StaticResource ShowBool}">
                                <DarkCheckBox_01
                                    HorizontalAlignment="Left"
                                    CheckedBg="#10B981"
                                    CheckedBorder="#10B981"
                                    Content="{Binding Description}"
                                    IsChecked="{Binding BoolValue}" />
                            </Grid>

                            <Grid Style="{StaticResource ShowInput}">
                                <DarkTextBox_01
                                    Height="28"
                                    VerticalContentAlignment="Center"
                                    OnHoverBorder="{StaticResource NeonAccent}"
                                    Placeholder="{Binding Placeholder}"
                                    Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="#FF9AA0A6"
                                Text="{Binding Description}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="#FFE74C3C"
                                Text="{Binding Error}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <DarkButton_01
                Width="80"
                Height="30"
                Padding="0"
                HorizontalAlignment="Left"
                Click="Reset_Click"
                Content="Reset"
                OnHoverBorder="#F59E0B"
                OnHoverForeground="#F59E0B" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <DarkButton_01
                    Width="84"
                    Height="30"
                    Margin="0,0,8,0"
                    Padding="0"
                    Click="Ok_Click"
                    Content="OK"
                    OnHoverBg="#064E3B"
                    OnHoverBorder="#10B981"
                    OnHoverForeground="#10B981" />
                <DarkButton_01
                    Width="84"
                    Height="30"
                    Padding="0"
                    Click="Cancel_Click"
                    Content="Cancel"
                    OnHoverBg="#2A1215"
                    OnHoverBorder="#EF4444"
                    OnHoverForeground="#EF4444" />
            </StackPanel>
        </Grid>
    </Grid>
</DarkWindow>