<DarkWindow
    x:Class="YHG_Assets_Handler.Workspace.UnityAssets.Plugins.Transform.EditTransformWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:YHG_Assets_Handler.Workspace.UnityAssets.Plugins.Transform"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Transform Editor"
    Width="470"
    Background="{StaticResource AppBg}"
    ResizeMode="NoResize"
    ShowButtons="Close"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <StackPanel Margin="16,14,16,14">

        <!--  Reference fields (PPtr)  -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!--  Row 0: m_GameObject  -->
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource PropValue_01}"
                Text="m_GameObject" />
            <DarkTextBox_01
                x:Name="txtGameObject"
                Grid.Column="1"
                Height="28"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                IsReadOnly="True"
                Placeholder="None (GameObject)" />
            <DarkButton_01
                x:Name="btnGameObject"
                Grid.Column="2"
                Width="28"
                Height="28"
                Padding="0"
                VerticalAlignment="Center"
                ToolTip="Pick GameObject (PPtr)">
                <iconPacks:PackIconMaterial
                    Width="13"
                    Height="13"
                    Kind="Pencil" />
            </DarkButton_01>

            <!--  Row 1: m_Father  -->
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Style="{StaticResource PropValue_01}"
                Text="m_Father" />
            <DarkTextBox_01
                x:Name="txtFather"
                Grid.Row="1"
                Grid.Column="1"
                Height="28"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                IsReadOnly="True"
                Placeholder="None (Transform)" />
            <DarkButton_01
                x:Name="btnFather"
                Grid.Row="1"
                Grid.Column="2"
                Width="28"
                Height="28"
                Padding="0"
                VerticalAlignment="Center"
                ToolTip="Pick Father Transform (PPtr)">
                <iconPacks:PackIconMaterial
                    Width="13"
                    Height="13"
                    Kind="Pencil" />
            </DarkButton_01>
        </Grid>

        <!--  Children: list + vertical buttons  -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Margin="0,6,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource PropValue_01}"
                Text="m_Children" />
            <DarkListBox_01
                x:Name="lstChildren"
                Grid.Column="1"
                Height="96"
                DisplayMemberPath="DisplayText"
                SelectionMode="Single" />
            <StackPanel
                Grid.Column="2"
                Margin="6,0,0,0"
                VerticalAlignment="Top">
                <DarkButton_01
                    x:Name="btnAddChild"
                    Width="28"
                    Height="28"
                    Margin="0,0,0,6"
                    Padding="0"
                    ToolTip="Add Child (PPtr)">
                    <iconPacks:PackIconMaterial
                        Width="13"
                        Height="13"
                        Kind="Plus" />
                </DarkButton_01>
                <DarkButton_01
                    x:Name="btnEditChild"
                    Width="28"
                    Height="28"
                    Margin="0,0,0,6"
                    Padding="0"
                    ToolTip="Edit Selected Child">
                    <iconPacks:PackIconMaterial
                        Width="13"
                        Height="13"
                        Kind="Pencil" />
                </DarkButton_01>
                <DarkButton_01
                    x:Name="btnRemoveChild"
                    Width="28"
                    Height="28"
                    Padding="0"
                    ToolTip="Remove Selected Child">
                    <iconPacks:PackIconMaterial
                        Width="13"
                        Height="13"
                        Kind="TrashCanOutline" />
                </DarkButton_01>
            </StackPanel>
        </Grid>

        <Separator Margin="0,0,0,10" Background="{StaticResource BorderColor}" />

        <!--  Position / Rotation / Scale: ek hi grid, uniform 3px margins  -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!--  Position  -->
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource PropValue_01}"
                Text="Position" />
            <DarkTextBox_01
                x:Name="txtPositionX"
                Grid.Column="1"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="X"
                Tag="X" />
            <DarkTextBox_01
                x:Name="txtPositionY"
                Grid.Column="2"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="Y"
                Tag="Y" />
            <DarkTextBox_01
                x:Name="txtPositionZ"
                Grid.Column="3"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="Z"
                Tag="Z" />

            <!--  Rotation (Quaternion)  -->
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Style="{StaticResource PropValue_01}"
                Text="Rotation (Q)" />
            <DarkTextBox_01
                x:Name="txtRotationX"
                Grid.Row="1"
                Grid.Column="1"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="X"
                Tag="X" />
            <DarkTextBox_01
                x:Name="txtRotationY"
                Grid.Row="1"
                Grid.Column="2"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="Y"
                Tag="Y" />
            <DarkTextBox_01
                x:Name="txtRotationZ"
                Grid.Row="1"
                Grid.Column="3"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="Z"
                Tag="Z" />
            <DarkTextBox_01
                x:Name="txtRotationW"
                Grid.Row="1"
                Grid.Column="4"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="W"
                Tag="W" />

            <!--  Scale  -->
            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Style="{StaticResource PropValue_01}"
                Text="Scale" />
            <DarkTextBox_01
                x:Name="txtScaleX"
                Grid.Row="2"
                Grid.Column="1"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="X"
                Tag="X" />
            <DarkTextBox_01
                x:Name="txtScaleY"
                Grid.Row="2"
                Grid.Column="2"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="Y"
                Tag="Y" />
            <DarkTextBox_01
                x:Name="txtScaleZ"
                Grid.Row="2"
                Grid.Column="3"
                Height="28"
                Margin="3,0"
                VerticalAlignment="Center"
                Placeholder="Z"
                Tag="Z" />
        </Grid>

        <!--  OK  -->
        <DarkButton_01
            x:Name="btnOk"
            Width="110"
            Height="32"
            Margin="0,14,0,0"
            Padding="0"
            HorizontalAlignment="Right"
            Content="OK"
            FontWeight="SemiBold"
            OnHoverBg="#064E3B"
            OnHoverBorder="#10B981"
            OnHoverForeground="#10B981" />
    </StackPanel>
</DarkWindow>