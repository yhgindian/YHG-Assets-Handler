<DarkWindow
    x:Class="YHG_Assets_Handler.Workspace.UnityAssets.Plugins.Texture2D.EditTextureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:YHG_Assets_Handler.Workspace.UnityAssets.Plugins.Texture2D"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Edit Texture2D"
    Width="440"
    Height="590"
    MinWidth="420"
    MinHeight="580"
    Background="{DynamicResource AppBg}"
    Foreground="{StaticResource TextLight}"
    ShowButtons="Close"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DarkWindow.Resources>
        <Style x:Key="ResetBtn" TargetType="{x:Type DarkButton_01}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="OnHoverBg" Value="#1E293B" />
            <Setter Property="OnHoverBorder" Value="{StaticResource NeonAccent}" />
            <Setter Property="OnHoverForeground" Value="{StaticResource NeonAccent}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Content" Value="reset" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <iconPacks:PackIconMaterial
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DarkButton_01}}}"
                            Kind="UndoVariant" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="RowLabel"
            BasedOn="{StaticResource PropLabel_01}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </DarkWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Margin="0,0,0,12"
            Padding="14,10"
            Style="{StaticResource PanelBorder_01}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource RowLabel}"
                    Text="Name" />
                <DarkTextBox_01
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    Foreground="Wheat"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="{Binding NameWatermark}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <DarkButton_01
                    Grid.Row="0"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="0"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Name" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource RowLabel}"
                    Text="Texture Format" />
                <DarkComboBox_01
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding TextureFormats}"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="(Multiple values)"
                    SelectedItem="{Binding TextureFormat}" />
                <DarkButton_01
                    Grid.Row="1"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="1"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Texture Format" />
                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource RowLabel}"
                    Text="Using Mipmaps" />
                <DarkCheckBox_01
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CheckedBg="#10B981"
                    CheckedBorder="#10B981"
                    IsChecked="{Binding UsingMips}"
                    IsThreeState="{Binding UsingMipsThreeOn}"
                    OnHoverBorder="{StaticResource NeonAccent}" />
                <DarkButton_01
                    Grid.Row="2"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="2"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Mipmaps" />
                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource RowLabel}"
                    Text="Is Readable" />
                <DarkCheckBox_01
                    Grid.Row="3"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CheckedBg="#10B981"
                    CheckedBorder="#10B981"
                    IsChecked="{Binding IsReadable}"
                    IsThreeState="{Binding IsReadableThreeOn}"
                    OnHoverBorder="{StaticResource NeonAccent}" />
                <DarkButton_01
                    Grid.Row="3"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="3"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Is Readable" />
                <TextBlock
                    Grid.Row="4"
                    Style="{StaticResource RowLabel}"
                    Text="Filter Mode" />
                <DarkComboBox_01
                    Grid.Row="4"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding FilterModes}"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="(Multiple values)"
                    SelectedItem="{Binding FilterMode}" />
                <DarkButton_01
                    Grid.Row="4"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="4"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Filter Mode" />
                <TextBlock
                    Grid.Row="5"
                    Style="{StaticResource RowLabel}"
                    Text="Anisotropic Filtering" />
                <DarkTextBox_01
                    Grid.Row="5"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="{Binding FilteringWatermark}"
                    Text="{Binding FilteringString, UpdateSourceTrigger=PropertyChanged}" />
                <DarkButton_01
                    Grid.Row="5"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="5"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Anisotropic Filtering" />
                <TextBlock
                    Grid.Row="6"
                    Style="{StaticResource RowLabel}"
                    Text="Mipmap Bias" />
                <DarkTextBox_01
                    Grid.Row="6"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    Foreground="White"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="{Binding MipBiasWatermark}"
                    Text="{Binding MipBiasString, UpdateSourceTrigger=PropertyChanged}" />
                <DarkButton_01
                    Grid.Row="6"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="6"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Mipmap Bias" />
                <TextBlock
                    Grid.Row="7"
                    Style="{StaticResource RowLabel}"
                    Text="Wrap Mode (U)" />
                <DarkComboBox_01
                    Grid.Row="7"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding WrapModes}"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="(Multiple values)"
                    SelectedItem="{Binding WrapModeU}" />
                <DarkButton_01
                    Grid.Row="7"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="7"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Wrap Mode U" />
                <TextBlock
                    Grid.Row="8"
                    Style="{StaticResource RowLabel}"
                    Text="Wrap Mode (V)" />
                <DarkComboBox_01
                    Grid.Row="8"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding WrapModes}"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="(Multiple values)"
                    SelectedItem="{Binding WrapModeV}" />
                <DarkButton_01
                    Grid.Row="8"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="8"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Wrap Mode V" />
                <TextBlock
                    Grid.Row="9"
                    Style="{StaticResource RowLabel}"
                    Text="Lightmap Format" />
                <DarkTextBox_01
                    Grid.Row="9"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="{Binding LightMapFormatWatermark}"
                    Text="{Binding LightMapFormatString, UpdateSourceTrigger=PropertyChanged}" />
                <DarkButton_01
                    Grid.Row="9"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="9"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Lightmap Format" />
                <TextBlock
                    Grid.Row="10"
                    Style="{StaticResource RowLabel}"
                    Text="Color Space" />
                <DarkComboBox_01
                    Grid.Row="10"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding ColorSpaces}"
                    OnHoverBorder="{StaticResource NeonAccent}"
                    Placeholder="(Multiple values)"
                    SelectedItem="{Binding ColorSpace}" />
                <DarkButton_01
                    Grid.Row="10"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="10"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Color Space" />
                <TextBlock
                    Grid.Row="11"
                    Style="{StaticResource RowLabel}"
                    Text="Texture Source" />
                <DarkButton_01
                    Grid.Row="11"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    Command="{Binding LoadSingleTextureCommand}"
                    IsEnabled="{Binding IsSingleTexture}"
                    OnHoverBg="#1E293B"
                    OnHoverBorder="#3B82F6"
                    OnHoverForeground="#3B82F6">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="12"
                            Height="12"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DarkButton_01}}}"
                            Kind="FolderOpenOutline" />
                        <TextBlock VerticalAlignment="Center" Text="Load Texture" />
                    </StackPanel>
                </DarkButton_01>
                <DarkButton_01
                    Grid.Row="11"
                    Grid.Column="2"
                    Command="{Binding ResetToDefaultCommand}"
                    CommandParameter="11"
                    IsEnabled="{Binding IsSingleTexture}"
                    Style="{StaticResource ResetBtn}"
                    ToolTip="Reset Texture Source" />
            </Grid>
        </Border>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <DarkButton_01
                Width="90"
                Height="30"
                Margin="0,0,8,0"
                Padding="10,6,10,6"
                Command="{Binding SaveChangesCommand}"
                Content="Save"
                OnHoverBg="#064E3B"
                OnHoverBorder="#10B981"
                OnHoverForeground="#10B981" />
            <DarkButton_01
                Width="90"
                Height="30"
                Padding="10,6,10,6"
                Command="{Binding CancelCommand}"
                Content="Close"
                OnHoverBg="#2A1215"
                OnHoverBorder="#EF4444"
                OnHoverForeground="#EF4444" />
        </StackPanel>
    </Grid>
</DarkWindow>